<UserControl x:Class="SacExam.MainMenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部横幅 -->
        <Border Grid.Row="0" Padding="36,26,36,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E5799" Offset="0"/>
                    <GradientStop Color="#143D74" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="证券从业模拟考试系统" Foreground="White" FontSize="30" FontWeight="Bold"/>
                <TextBlock Foreground="#BDD7EE" FontSize="13.5" Margin="0,8,0,0"
                           Text="证券行业专业人员水平评价测试 · 模拟练习系统"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Margin="36,20,36,16"/>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#EEF1F6" Padding="36,10">
            <TextBlock x:Name="FooterStats" Foreground="#7A8699" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
